# ==============================================================================
# Vion Backend Configuration
# ==============================================================================

# Server & Network
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Neon PostgreSQL Managed Database Connection String (Prisma ORM 8)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/vion?sslmode=verify-full

# Authentication & Password Hashing
SALT_ROUNDS=10
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_min_32_chars

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Object Storage (Supabase Storage) - Holds the actual video/image files
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-client
SUPABASE_RAW_BUCKET=raw-videos
SUPABASE_PROCESSED_BUCKET=processed-videos
SUPABASE_THUMBNAILS_BUCKET=thumbnails
# Optional public CDN domain for streaming delivery (e.g., https://media.yourdomain.com)
SUPABASE_PUBLIC_URL=

# ------------------------------------------------------------------------------
# Background Job Queue (Redis) - Stores job queues & worker messages
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Media Processing Limits & Binaries (Worker Environment)
# ------------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TEMP_MEDIA_DIR=./tmp/media
MAX_UPLOAD_SIZE_BYTES=524288000
MAX_PROCESSING_DURATION_SECONDS=1800
