# Server Port
PORT=3000

# PostgreSQL Connection String (Prisma 8)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vion_youtube?schema=public"

# Auth & Security
SALT_ROUNDS=10
JWT_SECRET_KEY="super_secret_jwt_key_replace_in_production"

# Frontend CORS Origin
FRONTEND_URL="http://localhost:5173"

# Node Environment
NODE_ENV="development"
